<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicular_distance_plugin</name>
  <version>0.0.0</version>
  <description>
    Gazebo Harmonic system plugin that publishes a one-shot distance result for
    a vehicle and target model, with optional Gazebo Transport activation.
  </description>
  <maintainer email="tanhongzhang639@gmail.com">joseph</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz-common5</depend>
  <depend>gz-math7</depend>
  <depend>gz-msgs10</depend>
  <depend>gz-plugin2</depend>
  <depend>gz-sim8</depend>
  <depend>gz-transport13</depend>
  <depend>sdformat14</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
